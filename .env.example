# ===========================================================================
# Made in France — variables d'environnement
# ===========================================================================
# Copier en `.env` à la racine et remplir. Toutes les commandes tournent depuis la
# racine ; `apps/web/.env` n'est qu'un lien symbolique, ignoré par git.
#
# Chaque variable ci-dessous est LUE PAR LE CODE (vérifié le 18 septembre 2026 :
# `grep process.env`). Les variables de services jamais branchés — Redis, Meilisearch,
# OpenAI, Mistral, S3, Apple, Resend, un « service IA » Python — ont été retirées : elles
# décrivaient une architecture qui n'a jamais existé et trompaient qui déployait.
#
# ⚠️ Pas de NODE_ENV ici. Next.js le fixe lui-même ; exporté depuis un fichier avant
# `next build`, `NODE_ENV=development` casse le build de production avec une erreur
# sans rapport (« Cannot read properties of null (reading 'useContext') »).

# ---------------------------------------------------------------------------
# OBLIGATOIRE — sans ces trois-là, rien ne démarre
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://mif_user:mif_password@localhost:5432/madeinfrance?schema=public"
# Pour `next build` contre une vraie base : ajouter `&connection_limit=5` — le build
# prérend ~900 pages en parallèle et sature un PostgreSQL local sinon.
NEXTAUTH_SECRET="changer-cette-valeur-32-caracteres-minimum"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Tests — la base d'intégration, vidée à chaque passage
# ---------------------------------------------------------------------------
# Dérivée automatiquement de DATABASE_URL (suffixe `_test`). À définir seulement si la
# base de test porte un autre nom. Refus de démarrer si égale à DATABASE_URL.
# DATABASE_URL_TEST=""

# ---------------------------------------------------------------------------
# Connexion — NextAuth
# ---------------------------------------------------------------------------
# NEXTAUTH_URL est lu par NextAuth lui-même, pas par notre code.
NEXTAUTH_URL="http://localhost:3000"
# Google (facultatif : sans ces deux valeurs, seul le mot de passe et l'e-mail marchent)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Connexion par lien e-mail (facultatif) — serveur SMTP
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT=""
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Made in France <noreply@exemple.fr>"

# ---------------------------------------------------------------------------
# Carte — Mapbox (la page /carte ne rend rien sans)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ---------------------------------------------------------------------------
# Paiement — Stripe. Version d'API figée dans lib/stripe.ts, pas ici.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
# Sans ce secret, le webhook REFUSE tout événement (jamais de repli non signé).
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# IA — Anthropic. La clé ne vit qu'ici : jamais en base, jamais dans l'admin.
# ANTHROPIC_MODEL est le modèle PAR DÉFAUT du chat, tant que l'admin n'en a pas choisi
# un dans site_settings (Haiku 4.5, Sonnet 5, Opus 5). L'enrichissement
# (`pnpm data:enrich`) n'envoie rien sans --appliquer.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"

# ---------------------------------------------------------------------------
# Images — Cloudinary (envoi de logos et visuels depuis le Studio et l'admin)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# Mesure d'audience — PostHog. PAS ENCORE BRANCHÉ (T7.3) : le jour où il le sera,
# il n'aura le droit de se charger qu'après consentement, et la page /confidentialite
# devra changer dans le même commit.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_POSTHOG_KEY=""
# NEXT_PUBLIC_POSTHOG_HOST="https://eu.posthog.com"
